# 프로젝트 루트 .gitignore

# Backend
backend/__pycache__/
backend/*.pyc
backend/.env
backend/credentials/
backend/uploads/
backend/venv/
backend/ENV/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.env
frontend/.env.local

# Google Cloud Credentials (매우 중요!)
**/credentials/
**/*.json
!**/package.json
!**/package-lock.json
!**/tsconfig.json

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Database
*.db
*.sqlite
*.sqlite3

# resources
*.pdf
*.csv

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
ENV/
env/
.venv

# # Environment Variables (매우 중요!)
.env
.env.local
.env.*.local
.env.docker
.env.openai
.env.production
backend/.env.openai
frontend/.env.production

# Google Cloud Credentials (중요!)
credentials/
*.json
!package.json
!package-lock.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Database
*.db
*.sqlite
*.sqlite3

# Database Dumps & Migration Scripts (비밀번호 포함 가능)
backup.sql
backup_utf8.sql
local_schema.sql
schema_only.sql
data_only.sql
data_insert.sql
copy_data.sql
migrate_data.py
migrate_data_final.py

# Uploads (이미지 파일은 Git에 포함하지 않음)
uploads/

# Part List Extracted Results
part_list/daedong_part_list/트랙터/extracted_result/

# Part List Raw PDFs
part_list/daedong_part_list/트랙터/raw_pdfs/

# part list pdf files
part_list/daedong_part_list/트랙터/*.pdf
part_list/daedong_part_list/트랙터/*.png

# 모든 하위 폴더에서 png, pdf, csv 제외
**/*.png
**/*.pdf
**/*.csv

# 특정 경로의 결과물 폴더 제외
part_list/**/extracted_result/
part_list/**/raw_pdfs/

# 보안 관련 파일들
SECURITY_*.md
SET_NEW_API_KEY.md
api-keys.txt
bfg.jar
CRITICAL_SECURITY_ALERT.md
GIT_HISTORY_CLEANUP.md
PROJECT_SECURITY_STATUS.md
NEXT_STEPS.md

# 테스트 및 임시 파일들
test_*.py
*.sql
!init.sql

# 크롤링 및 데이터 파일
크롤링용 파일/
data/
VSCODE_DATABASE_CONNECTION.md
DEPLOYMENT_GUIDE.md
RENDER_SETUP_CHECKLIST.md
