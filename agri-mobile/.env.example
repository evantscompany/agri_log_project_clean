# OpenAI API Key
# https://platform.openai.com/api-keys 에서 발급받으세요
EXPO_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here

# API Configuration
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.90:8000/api/v1
EXPO_PUBLIC_API_TIMEOUT=30000

# 개발 환경에서는 아래 주석 해제하여 사용
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1  # Android 에뮬레이터
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1  # iOS 시뮬레이터
