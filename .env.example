# ⚠️ 보안 경고: 실제 API 키를 절대로 이 파일에 저장하지 마세요!
# 이 파일은 예시용이며, 실제 값은 .env 파일에 저장하세요
# .env 파일은 .gitignore에 포함되어 Git에 커밋되지 않습니다

# ========================================
# 데이터베이스 설정 (필수)
# ========================================
# 강력한 비밀번호를 사용하세요 (최소 16자, 대소문자+숫자+특수문자)
MYSQL_ROOT_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
MYSQL_DATABASE=agrilog_db
MYSQL_USER=agri_user
MYSQL_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

# ========================================
# OpenAI API 키 (필수)
# ========================================
# https://platform.openai.com/api-keys 에서 발급받으세요
# ⚠️ 주의: 백엔드에서만 사용하세요. 프론트엔드에서 직접 사용하지 마세요!
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ========================================
# Google Vision API 설정 (OCR 기능 사용 시 필수)
# ========================================
# Google Cloud Console에서 서비스 계정 JSON 키 파일을 다운로드하세요
# credentials/ 폴더에 저장하고 경로를 지정하세요
GOOGLE_APPLICATION_CREDENTIALS=./backend/credentials/google-vision-credentials.json

# ========================================
# 프론트엔드 설정
# ========================================
# 개발 환경: http://localhost:8000
# 프로덕션 환경: https://your-production-domain.com
VITE_API_URL=http://localhost:8000

# ⚠️ 보안 경고: 프론트엔드에서 OpenAI API를 직접 호출하지 마세요!
# 대신 백엔드 API를 통해 호출하세요
# VITE_OPENAI_API_KEY는 사용하지 않음 (보안상 위험)

# ========================================
# 모바일 앱 설정 (Expo)
# ========================================
# 개발 환경: 로컬 네트워크 IP 주소 사용
# 실제 기기 테스트 시: WiFi IP 주소로 변경 (예: 192.168.x.x)
# 에뮬레이터 테스트 시: 10.0.2.2 (Android) 또는 localhost (iOS)
EXPO_PUBLIC_API_BASE_URL=http://YOUR_LOCAL_IP:8000/api/v1
EXPO_PUBLIC_API_TIMEOUT=30000

# ⚠️ 모바일 앱에서도 OpenAI API 키를 직접 사용하지 마세요!
# 백엔드 API를 통해 호출하세요

# ========================================
# 기타 설정
# ========================================
TZ=Asia/Seoul
